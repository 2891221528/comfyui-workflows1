ts":[{"label":"可选连接","name":"OPT_CONNECTION","type":"*","links":null}],"properties":{"matchColors":"","matchTitle":"①ERNIE_Image-turbo-初生图","showNav":true,"showAllGraphs":true,"sort":"position","customSortAlphabet":"","toggleRestriction":"default","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.6.2"}}},{"id":90,"type":"Label (rgthree)","pos":[4058.1037569046334,123.91371364371253],"size":[1283.447265625,100],"flags":{"allow_interaction":true},"order":13,"mode":0,"inputs":[],"outputs":[],"title":"▶ERNIE-Image-原版-生图流","properties":{"fontSize":100,"fontFamily":"Arial","fontColor":"#3CB371","textAlign":"left","backgroundColor":"transparent","padding":0,"borderRadius":0,"angle":0,"ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"color":"#fff0","bgcolor":"#fff0"},{"id":89,"type":"Label (rgthree)","pos":[2218.6392390007445,104.09132233061635],"size":[1311.376953125,100],"flags":{"allow_interaction":true},"order":14,"mode":0,"inputs":[],"outputs":[],"title":"▶ERNIE-Image-turbo-生图流","properties":{"fontSize":100,"fontFamily":"Arial","fontColor":"#3CB371","textAlign":"left","backgroundColor":"transparent","padding":0,"borderRadius":0,"angle":0,"ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"color":"#fff0","bgcolor":"#fff0"},{"id":91,"type":"Label (rgthree)","pos":[1042.322780328568,212.14185743806004],"size":[212.5625,38],"flags":{"allow_interaction":true},"order":15,"mode":0,"inputs":[],"outputs":[],"title":"♥提示词示例","properties":{"fontSize":38,"fontFamily":"Arial","fontColor":"#FF6347","textAlign":"left","backgroundColor":"transparent","padding":0,"borderRadius":0,"angle":0,"ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"color":"#fff0","bgcolor":"#fff0"},{"id":84,"type":"Note","pos":[1040.552971061278,298.5789508273314],"size":[663.5984878193356,1035.377646588166],"flags":{},"order":16,"mode":0,"inputs":[],"outputs":[],"properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["一个超现实的电影场景：一辆复古重型蓝色摩托车在猛烈撞击地面后悬浮在半空中。摩托车漂浮在开裂的柏油路面上方，尘土、飞溅的石块、破碎的混凝土碎片和散落的纸张都以慢动作凝固。一个复古的黑色头盔在旁边旋转，强调了动感。黑暗的电影工作室环境中弥漫着烟雾和体积光线。来自右上方的强烈定向照明在弯曲的金属面板上产生光泽反射。超精细的油漆纹理，镀铬后视镜微妙地反射着光线，逼真的橡胶轮胎表面。定格动作瞬间如同超高速摄影般捕捉，戏剧性的悬浮重力效果，电影般的真实感，浅景深，漂浮的碎片清晰可见。使用全画幅相机拍摄，85mm 镜头，f/2.8 光圈，超清晰对焦，高对比度，照片级真实感渲染，史诗般的电影氛围，深色渐变背景，工作室爆炸效果，8K 细节。\n\n画面风格：赛博朋克微缩场景 3D 渲染，超写实 8K 高清，极致细节，电影级光影，创意概念艺术，融合真实易拉罐质感与未来都市风格，画面锐利清晰，质感通透。核心元素：被剖开的蓝色易拉罐，内部构建出多层螺旋式立体都市，易拉罐作为主体容器，都市细节丰富，背景为纯净的深蓝色，整体采用中心构图，突出微缩世界的创意感。具体内容：易拉罐主体为亮蓝色金属材质，顶部保留银色拉环与罐盖，罐身做剖开设计，露出内部多层螺旋结构的立体都市。从上至下，顶层为未来感摩天大楼群，玻璃幕墙搭配蓝色霓虹灯光，高架环形公路上行驶着黄色轿车；中层为现代城市建筑，高架公路上行驶着蓝色轿车，搭配电线杆、绿植；底层为复古石砌小屋，公路上行驶着红色轿车，有行人在街道、步道上活动，搭配石阶、绿植、砖墙。罐身外侧布满银色机械管道、阀门、螺丝等工业结构，强化赛博朋克机械感。背景为纯净浅蓝色，凸显主体，形成强烈视觉冲击。构图方式：中心垂直构图，易拉罐占据画面主体，多层螺旋都市形成视觉引导线，将视线从顶层引向底层，空间纵深感极强，层次清晰。光影效果：主光源来自都市霓虹，形成冷暖对比，罐内蓝色霓虹光与暖黄色室内光交织，易拉罐金属质感有轻微高光，整体光影层次丰富，氛围感拉满。材质质感：易拉罐金属质感强烈，罐内建筑为玻璃、混凝土、砖石等真实材质，霓虹灯光通透，路面沥青质感真实，人物衣物纹理清晰，机械结构精密，材质对比丰富，增强画面真实感。技术参数：3D 渲染，Octane 渲染器，8K 分辨率，全局光照，物理级渲染，景深效果，焦点清晰对准易拉罐与都市主体，背景虚化，色彩校准精准，还原高饱和赛博朋克色彩。色彩基调：以易拉罐的亮蓝色为主，搭配都市的白、蓝、红、黄等色彩，银色机械结构点缀，深色背景，形成强烈冷暖对比，视觉冲击力强。整体氛围：创意奇幻，赛博朋克未来感，微缩世界的奇妙感，科技感与生活感融合，充满想象力与视觉张力，适合作为创意设计、概念艺术作品。\n\n落地窗阳光诱惑风，镜头选择 35mm f/1.4，一位23岁的东亚女性模特，皮肤白皙纯净，拥有甜美圆脸，无辜大眼，嘴唇半张散发着极强的水润高光，细腰盈盈，发型为银灰色的娇俏可爱双麻花辫垂在胸前，身着一件白色路肩毛衣，侧面角度，靠着落地窗，双手背在身后微微挺胸沐浴在阳光中，贝齿轻咬下唇，眼神无辜散发着极致的诱惑力，置身于明亮宽敞的阳台落地窗前。采用平视的半身构图，浅景深，色调为明媚的高调纯白色。微微挺胸的动作极限放大了胸部的极致垂坠感，阳光下肌肤泛着微汗的光泽，布料与麻花辫在胸前交织出蕾丝阴影。前景飘动的半透明白纱虚化。背景窗外的绿植斑驳光影虚化。强烈的阳光从正面柔和包裹上半身。8K超高分辨率，半身特写、高动态范围、冷白皮透亮、明亮居家氛围、胸部线条精致立体、梦幻纯欲。衣服有精致的印花Logo（\"heihe001\"），字体优雅流畅，点缀着一个可爱的卡通猫咪图案，为整体柔和的色调增添了一丝俏皮与品牌辨识度。\n\n真实幻想风格，质感细腻，色彩温暖浓郁，整体氛围治愈浪漫，充满思念与温柔的情绪。核心元素：巨型白色猫咪，站在阳台伸手的红衣少女，云端黄色欧式建筑，浅蓝色天空，思念主题文字。具体内容：画面主体是一只巨型白色长毛猫，闭着眼睛神态温柔安详，毛发蓬松柔软，白色毛发层次分明，胡须纤细清晰，侧脸朝向右侧少女，猫咪底部被云雾笼罩。画面右侧是一栋悬浮在云端的浅黄色欧式多层建筑，建筑带有阳台、窗户与烟囱，一位少女站在建筑中层阳台，身着粉色连衣裙，棕发短双马尾，伸手朝向猫咪，姿态充满思念。背景是浅蓝色天空，点缀蓬松的白色云海，阳光从云层间透出，形成柔和的光晕。画面左上有白色大字标题 “守护 Guardian”，手写花体字，极细字体，线条奔放，富有张力部分笔画夸张拖长，共用笔画。构图方式：采用左右对称构图，猫咪与少女形成视觉呼应，建筑与云海形成空间纵深感，比例对比强烈。光线采用暖调黄昏自然光，从侧后方照射，形成柔和的逆光轮廓光，猫毛与少女衣物的质感细腻真实，光影过渡自然。色彩基调以暖红、米白、明黄、朱红为主，营造出温暖治愈、充满思念的氛围。\n\n广阔自然风景，壮丽山脉，清澈湖泊，镜面倒影，清晨薄雾，柔和金色光线，蓝天白云，茂密森林，光影层次丰富，氛围感宁静治愈，色彩柔和高级，细节丰富，电影级质感，超高清 8K，写实摄影，壁纸级画质，\n\n画面风格：新中式水墨创意插画，融合负形美学与传统国风，高分辨率超高清呈现，光影层次细腻柔和，色彩清新雅致，整体氛围空灵诗意，极具东方禅意与视觉巧思。核心元素：燕子负形轮廓内的江南春景，深绿背景，构图采用中心聚焦式，燕子轮廓为天然画框，江南春景居于视觉中心，空间层次分明。具体内容：以绿色为底，用淡墨晕染出一只展翅飞燕的负形轮廓，轮廓内呈现完整江南春景：白墙黑瓦的徽派民居错落排布，枝头绽放白色杏花，悬挂红色灯笼，两只飞燕在画面右侧翩飞，搭配祥云、淡青色远山与圆形水纹，细节精致，意境悠远。构图方式：负形创意构图，以燕子轮廓为天然画框，框内江南春景形成视觉焦点，框外深绿背景强化对比，最大化视觉冲击力。光线为柔和的漫射光，均匀照亮春景，突出水墨晕染的通透质感，色彩过渡自然。确保建筑细节、花枝纹理、飞燕轮廓清晰锐利。整体色彩基调以青、白、红、黑为主，营造出空灵悠远、诗意盎然的东方山水意境，完美融合传统水墨与现代创意美学。\n下方标题白色书法大字“谷雨”附有小字介绍“谷雨是春季最后一个节气，意为雨生百谷。此时降水明显增多，利于谷物生长，万物生长繁茂，也是春耕春种的关键时节”\n\n画面风格：写实自然风光摄影风格，高清晰度高分辨率，光影层次丰富，色彩还原真实通透，整体氛围宁静治愈，充满希望感，电影级质感。核心元素：一棵枝繁叶茂的巨型古樟树，树下木质长椅，背对镜头静坐的人物，远处层叠山脉，晴朗蓝天，画面下方有书法字体标题与上映信息，构图采用三分法，前景为大树与草地，中景为长椅与人物，远景为山脉与天空，空间纵深感强烈。具体内容：巨型古樟树树干粗壮苍劲，树皮纹理深邃，树冠浓密舒展，翠绿叶片层层叠叠，阳光从树冠缝隙穿透形成丁达尔光束，镜头眩光自然呈现。木质长椅为经典户外款式，浅棕色木纹清晰，人物背对镜头，身形轮廓柔和，静坐于长椅中央，面向远山。前景草地绿意盎然，光影斑驳，中景人物与长椅形成视觉焦点，远景是连绵起伏的青蓝色山脉，层次分明，天空为澄澈的湛蓝色，点缀少量轻薄白云。画面下方有白色毛笔书法字体 “自然前行”，下方配英文 “Natural Forward”，字体风格苍劲有力。构图方式：采用竖幅构图，9:16 比例，三分法布局，大树占据画面上半部分，人物与长椅位于画面中下部视觉中心，前景草地与树干形成框架式构图，引导视线聚焦人物。确保树干、人物与远景细节清晰锐利。光线为正午侧逆光，从树冠左上方照射，形成强烈的丁达尔体积光，人物与树干轮廓有自然辉光，阴影过渡柔和，环境光遮蔽增强立体感。整体色彩基调以翠绿色、湛蓝色为主，辅以暖金色阳光，营造出向阳而生的温暖治愈氛围。\n\n画面风格：私房人像摄影，8K 超高清，光影柔和明亮，厨房场景，整体氛围性感甜美，充满生活感。核心元素：年轻东亚女性，紫色蕾丝围裙，草莓，厨房背景。具体内容：女性拥有乌黑卷发，五官精致，红唇艳丽，眼神妩媚。身着紫色蕾丝围裙，印有 HeiHe 字样和小猫图案，手持草莓，面前是一碗草莓，背景是厨房台面。构图方式：中心特写构图，人物位于画面中心，草莓作为视觉焦点，背景虚化突出主体。光影效果：柔和侧光，高光细腻，阴影过渡自然，整体氛围性感甜美。材质质感：蕾丝面料细腻，皮肤通透，发丝细节拉满。技术参数：全画幅相机，85mm 定焦镜头，光圈 f/1.4，ISO 100，单点对焦，细节清晰。色彩基调：以紫、红、肤为主，整体色彩浓郁甜美，生活感十足。"],"color":"#432","bgcolor":"#653"},{"id":88,"type":"Label (rgthree)","pos":[2034.9893141469108,-301.3116465973304],"size":[3500.41015625,280],"flags":{"allow_interaction":true},"order":17,"mode":0,"inputs":[],"outputs":[],"title":"▶ERNIE-Image-生图流整合","properties":{"fontSize":280,"fontFamily":"Arial","fontColor":"#3CB371","textAlign":"left","backgroundColor":"transparent","padding":0,"borderRadius":0,"angle":0,"ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{}}},"color":"#fff0","bgcolor":"#fff0"}],"links":[[2,4,0,2,1,"VAE"],[4,8,0,3,1,"CONDITIONING"],[5,5,0,3,2,"CONDITIONING"],[6,1,0,3,3,"LATENT"],[7,8,0,5,0,"CONDITIONING"],[8,6,0,8,0,"CLIP"],[9,2,0,9,0,"IMAGE"],[10,11,0,3,4,"INT"],[11,3,0,12,0,"LATENT"],[12,12,0,2,0,"LATENT"],[78,62,0,58,0,"LATENT"],[79,60,0,58,1,"VAE"],[81,58,0,61,0,"IMAGE"],[82,63,0,62,0,"LATENT"],[84,64,0,63,1,"CONDITIONING"],[86,67,0,63,3,"LATENT"],[87,66,0,63,4,"INT"],[88,57,0,64,0,"CLIP"],[102,7,0,3,0,"MODEL"],[106,65,0,63,0,"MODEL"],[107,57,0,87,0,"CLIP"],[108,87,0,63,2,"CONDITIONING"]],"groups":[{"id":3,"title":"①ERNIE_Image-turbo-初生图","bounding":[2081.764385742894,268.3990793162411,1649.8658025729865,930.4451599500006],"color":"#3f789e","flags":{}},{"id":7,"title":"①ERNIE_Image-原版-生图流","bounding":[3865.9655172882635,278.01178247383643,1649.8658025729865,930.4451599500006],"color":"#3f789e","flags":{}}],"config":{},"extra":{"ue_links":[],"ds":{"scale":0.5209868481925334,"offset":[-434.6221435817886,1017.5460362742009]},"links_added_by_ue":[]},"version":0.4}