猫毛与少女衣物的质感细腻真实，光影过渡自然。色彩基调以暖红、米白、明黄、朱红为主，营造出温暖治愈、充满思念的氛围。"],"color":"#232","bgcolor":"#353"},{"id":57,"type":"CLIPLoader","pos":[3911.1223382289795,537.6511988707323],"size":[467.4804557649027,107.12126367868791],"flags":{},"order":6,"mode":4,"inputs":[{"localized_name":"CLIP名称","name":"clip_name","type":"COMBO","widget":{"name":"clip_name"},"link":null},{"localized_name":"类型","name":"type","type":"COMBO","widget":{"name":"type"},"link":null},{"localized_name":"设备","name":"device","shape":7,"type":"COMBO","widget":{"name":"device"},"link":null}],"outputs":[{"localized_name":"CLIP","name":"CLIP","type":"CLIP","links":[88,107]}],"properties":{"cnr_id":"comfy-core","ver":"0.3.73","Node name for S&R":"CLIPLoader","ue_properties":{"widget_ue_connectable":{},"version":"7.7","input_ue_unconnectable":{}},"enableTabs":false,"tabWidth":65,"tabXOffset":10,"hasSecondTab":false,"secondTabText":"Send Back","secondTabOffset":80,"secondTabWidth":65,"models":[{"name":"ministral-3-3b.safetensors","url":"https://huggingface.co/Comfy-Org/ERNIE-Image/resolve/main/text_encoders/ministral-3-3b.safetensors","directory":"text_encoders"}]},"widgets_values":["ministral-3-3b.safetensors","flux2","default"],"color":"#323","bgcolor":"#535"},{"id":62,"type":"LayerUtility: PurgeVRAM V2","pos":[4533.7329099363615,1017.8759312707012],"size":[210,82.67695089379276],"flags":{"collapsed":true},"order":24,"mode":4,"inputs":[{"localized_name":"任意内容","name":"anything","type":"*","link":82},{"localized_name":"清除缓存","name":"purge_cache","type":"BOOLEAN","widget":{"name":"purge_cache"},"link":null},{"localized_name":"清除模型","name":"purge_models","type":"BOOLEAN","widget":{"name":"purge_models"},"link":null}],"outputs":[{"localized_name":"any","name":"any","type":"*","links":[78]}],"properties":{"aux_id":"chflame163/ComfyUI_LayerStyle","ver":"d94bef1ee5ed3656f5ff1bb2830a4ffd94f40935","Node name for S&R":"LayerUtility: PurgeVRAM V2","cnr_id":"comfyui_layerstyle","ue_properties":{"widget_ue_connectable":{},"inpu