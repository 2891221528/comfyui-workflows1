身微前倾，一手抬至下巴附近、身体略微侧转、眼睛盯着镜头方向； 白色蕾丝紧身裙、束腰设计、裙摆较短、搭配白色透袜，颈部配戴多层白色蕾丝颈圈和一串大溪地粉彩珍珠项链、整体呈现繁复宫廷感，层叠的丝质缎带头饰，服饰蕾丝花纹清晰、珍珠有轻微高光； 柔和漫射光、亮度高、阴影极浅、整体类似高调摄影，冷偏中性白调、整体饱和度偏低、对比度中等偏低； 唯美人像、白色梦幻、轻婚纱感、宫廷蕾丝、私房写真氛围，画面额外添加颗粒感和跑焦缺陷，风格关键词：可爱、精致、柔弱、安静、空灵。画面细节丰富，主体突出，整体凝固感。"],"color":"#432","bgcolor":"#653"},{"id":140,"type":"CLIPTextEncode","pos":[3662.699836266007,-253.45590699265304],"size":[503.60636032093953,206.59014370862917],"flags":{},"order":17,"mode":4,"inputs":[{"localized_name":"clip","name":"clip","type":"CLIP","link":217},{"localized_name":"文本","name":"text","type":"STRING","widget":{"name":"text"},"link":null}],"outputs":[{"localized_name":"条件","name":"CONDITIONING","type":"CONDITIONING","slot_index":0,"links":[212]}],"title":"CLIP Text Encode (Positive Prompt)","properties":{"cnr_id":"comfy-core","ver":"0.3.48","Node name for S&R":"CLIPTextEncode","ue_properties":{"version":"7.5.2","widget_ue_connectable":{},"input_ue_unconnectable":{}},"enableTabs":false,"tabWidth":65,"tabXOffset":10,"hasSecondTab":false,"secondTabText":"Send Back","secondTabOffset":80,"secondTabWidth":65},"widgets_values":["一位年轻英武的东方女孩，面容精致，皮肤白皙，红色汉服，精美刺绣，日月花纹，长袖，专注于脸，专注于眼睛，非常细致的脸，非常漂亮的脸，很清澈的脸，棕色的眼睛，站在湖水之中，湖水浸湿了她的头发与衣裙，衣衫凌乱，露肩，露背，手捂胸前，挡住了正在下滑的衣服。背景是高山下的瀑布。"],"color":"#232","bgcolor":"#353"},{"id":115,"type":"CLIPTextEncode","pos":[1220.2257198964126,-244.65182956760017],"size":[502.383178511971,206.14163002487385],"flags":{},"order":19,"mode":0,"inputs":[{"localized_name":"clip","name":"clip","type":"CLIP","link":175},{"localized_name":"文本","name":"text","type":"STRING","widget":{"name":"text"},"link":null}],"outputs":[{"localized_name":"条件","name":"CONDITIONING","type":"CONDITIONING","slot_index":0,"links":[182]}],"title":"CLIP Text Encode (Positive Prompt)","properties":{"cnr_id":"comfy-core","ver":"0.3.48","Node name for S&R":"CLIPTextEncode","ue_properties":{"version":"7.5.2","widget_ue_connectable":{},"input_ue_unconnectable":{}},"enableTabs":false,"tabWidth":65,"tabXOffset":10,"hasSecondTab":false,"s